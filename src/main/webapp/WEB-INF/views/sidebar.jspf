<%-- sidebar.jspf – Shared sidebar navigation fragment
     Include in each view with: <%@ include file="sidebar.jspf" %>
     The hosting page sets:  String activePage = "dashboard"; (or customers/plans/subscriptions/payments)
--%>
<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%
    // activePage should be set by the including JSP before this include
    String _activePage = (activePage != null) ? activePage : "";
%>
<aside class="sidebar" role="navigation" aria-label="Main navigation">

    <!-- Brand -->
    <div class="sidebar-brand">
        <div class="sidebar-brand-icon" style="background: #fff; border-radius: 50%; padding: 2px; overflow: hidden;">
            <img src="${pageContext.request.contextPath}/images/logo.jpeg" alt="Logo" style="width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; filter: contrast(1.5) brightness(1.1);">
        </div>
        <div>
            <div class="sidebar-brand-title">Subscription</div>
            <div class="sidebar-brand-subtitle">Management System</div>
        </div>
    </div>

    <!-- Collapse Toggle Button -->
    <button class="sidebar-toggle-btn" id="sidebar-toggle-btn" onclick="toggleSidebar()" title="Toggle Sidebar" aria-label="Toggle Sidebar">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
        </svg>
    </button>

    <!-- Navigation -->
    <nav class="sidebar-nav">
        <div class="sidebar-section-label">Main Menu</div>

        <!-- Dashboard (handled via LoginServlet / home) -->
        <a href="LoginServlet?action=dashboard" class="nav-item <%= _activePage.equals("dashboard") ? "active" : "" %>"
           id="nav-dashboard" data-page="dashboard" title="Dashboard">
            <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span class="nav-label">Dashboard</span>
        </a>

        <!-- Customers -->
        <a href="CustomerServlet" class="nav-item <%= _activePage.equals("customers") ? "active" : "" %>"
           id="nav-customers" data-page="customers" title="Customers">
            <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17 20h5v-1a3 3 0 00-5.356-1.857M17 20H7m10 0v-1c0-.656-.126-1.284-.356-1.857M7 20H2v-1a3 3 0 015.356-1.857M7 20v-1c0-.656.126-1.284.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            <span class="nav-label">Customers</span>
        </a>

        <!-- Plans -->
        <a href="PlanServlet" class="nav-item <%= _activePage.equals("plans") ? "active" : "" %>"
           id="nav-plans" data-page="plans" title="Plans">
            <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
            </svg>
            <span class="nav-label">Plans</span>
        </a>

        <!-- Subscriptions -->
        <a href="SubscriptionServlet" class="nav-item <%= _activePage.equals("subscriptions") ? "active" : "" %>"
           id="nav-subscriptions" data-page="subscriptions" title="Subscriptions">
            <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            <span class="nav-label">Subscriptions</span>
        </a>

        <!-- Payments -->
        <a href="PaymentServlet" class="nav-item <%= _activePage.equals("payments") ? "active" : "" %>"
           id="nav-payments" data-page="payments" title="Payments">
            <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
            </svg>
            <span class="nav-label">Payments</span>
        </a>

        <!-- Reports -->
        <a href="ReportServlet" class="nav-item <%= _activePage.equals("reports") ? "active" : "" %>"
           id="nav-reports" data-page="reports" title="Reports">
            <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
            <span class="nav-label">Reports</span>
        </a>

        <div class="sidebar-section-label" style="margin-top:8px;">System</div>

        <!-- Settings -->
        <a href="SettingsServlet" class="nav-item <%= _activePage.equals("settings") ? "active" : "" %>" id="nav-settings" data-page="settings" title="Settings">
            <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="nav-label">Settings</span>
        </a>
    </nav>

    <!-- Footer / Logout -->
    <div class="sidebar-footer">
        <a href="LogoutServlet" class="nav-item logout" id="nav-logout" title="Logout"
           onclick="return confirm('Are you sure you want to logout?')">
            <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            <span class="nav-label">Logout</span>
        </a>
    </div>

</aside>
